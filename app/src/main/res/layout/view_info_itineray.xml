<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TODO write the name of the selected itinerary in the title -->
    <!-- Header fixe -->
    <include layout="@layout/component_header_back_icon" />

    <!-- Fix footer -->
    <include layout="@layout/component_footer" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/form_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/no_dp"
        android:layout_marginHorizontal="@dimen/form_margin"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintWidth_min="wrap">

        <TextView
            android:id="@+id/title_list_clients_added"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_list_clients_added_for_itinerary"
            android:textSize="@dimen/big_text"
            android:layout_marginTop="@dimen/small_gap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/form_container" />


        <ListView
            android:id="@+id/list_items_clients_added"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title_list_clients_added"
            app:layout_constraintBottom_toTopOf="@id/button_start_itinerary"
            app:layout_constraintStart_toStartOf="parent"
            />

        <Button
            android:id="@+id/button_start_itinerary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_gap"
            android:layout_marginBottom="@dimen/normal_gap"
            android:backgroundTint="@color/blue_0"
            android:text="@string/button_start_itinerary"
            android:drawableLeft="@drawable/icon_start"
            android:textSize="@dimen/normal_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>