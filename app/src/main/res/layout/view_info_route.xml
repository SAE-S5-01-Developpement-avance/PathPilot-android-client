<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header and Footer includes remain the same -->
    <include layout="@layout/component_header_back_icon" />
    <include layout="@layout/component_footer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/form_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/form_margin"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Timeline Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/timeline_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/normal_gap"
            app:layout_constraintBottom_toTopOf="@id/resume_button"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Resume Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resume_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_gap"
            android:backgroundTint="@color/blue_0"
            android:padding="@dimen/normal_gap"
            android:text="Resume"
            android:textColor="@color/white"
            app:icon="@drawable/icon_start"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>