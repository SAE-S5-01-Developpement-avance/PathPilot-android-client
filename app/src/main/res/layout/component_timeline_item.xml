<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Timeline Line -->
    <View
        android:id="@+id/timeline_line"
        android:layout_width="10dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:background="#0093B8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/timeline_arrow" />

    <!-- Timeline Arrow (initially gone) -->
    <View
        android:id="@+id/timeline_arrow"
        android:layout_width="33dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:background="@drawable/arrow_line"
        app:layout_constraintStart_toStartOf="@id/timeline_line"
        app:layout_constraintEnd_toEndOf="@id/timeline_line"
        app:layout_constraintTop_toBottomOf="@id/address_container"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Timeline Dot -->
    <View
        android:id="@+id/timeline_dot"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@id/address_container"
        app:layout_constraintEnd_toEndOf="@id/timeline_line"
        app:layout_constraintStart_toStartOf="@id/timeline_line"
        app:layout_constraintTop_toTopOf="@id/address_container"
        tools:background="@drawable/visited_dot" />

    <!-- Address -->
    <LinearLayout
        android:id="@+id/address_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Client Info -->
        <TextView
            android:id="@+id/timeline_client_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:textColor="#0093B8"
            android:textSize="14sp"
            tools:text="AVEHO SOFT &amp; SERVICES (CLIENT)" />
        <TextView
            android:id="@+id/timeline_client_address"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:textColor="#0093B8"
            android:textSize="14sp"
            tools:text="3 rue Des clients pas contents qui demandent à faire grève parce que pas cool" />


    <!-- Bottom Spacing -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/timeline_client_address" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>