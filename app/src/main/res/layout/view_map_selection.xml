<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/adresse_label"
        android:text="Adresse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DefaultLabelStyle"
        android:layout_marginHorizontal="@dimen/micro_gap"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/adresse_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/micro_gap"
        app:layout_constraintTop_toBottomOf="@+id/adresse_label">
    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:id="@+id/adresse_input"
        android:autofillHints="postalAddress"/>

    <Button
        android:id="@+id/search"
        android:text="@string/search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/DefaultButtonStyle"
        android:layout_marginStart="@dimen/micro_gap"/>
    </LinearLayout>



    <org.osmdroid.views.MapView
        android:id="@+id/mapview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/adresse_input_layout"
        app:layout_constraintHeight_percent="0.6" />

    <Button
        android:id="@+id/select"
        android:text="@string/validate_selected_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DefaultButtonStyle"
        android:layout_marginBottom="@dimen/micro_gap"
        app:layout_constraintTop_toBottomOf="@+id/mapview"
        app:layout_constraintBottom_toTopOf="@+id/footer" />

    <include layout="@layout/component_footer"/>

</androidx.constraintlayout.widget.ConstraintLayout>